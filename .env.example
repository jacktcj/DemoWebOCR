# Development only. Never commit a real Regula license.
# Production should use Regula domain-name licensing instead.
VITE_REGULA_LICENSE=

# Recommended for OpenAI OCR. Keep this server-side and never commit it.
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.6-luna

# GPT-5.6 Luna standard processing rates per 1M tokens (verified 2026-08-10).
# USD_TO_MYR uses the latest available Bank Negara Malaysia KL reference rate.
OPENAI_INPUT_USD_PER_1M=1.00
OPENAI_CACHED_INPUT_USD_PER_1M=0.10
OPENAI_OUTPUT_USD_PER_1M=6.00

# DeepSeek V4 Flash uses browser OCR first because the model accepts text, not images.
DEEPSEEK_API_KEY=
DEEPSEEK_OCR_MODEL=deepseek-v4-flash
DEEPSEEK_INPUT_USD_PER_1M=0.14
DEEPSEEK_CACHED_INPUT_USD_PER_1M=0.0028
DEEPSEEK_OUTPUT_USD_PER_1M=0.28
USD_TO_MYR=4.0651
